# Copie este arquivo para ".env" e ajuste os valores

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-esta-chave-em-producao

# Banco de dados (valores batem com o docker-compose.yml)
DATABASE_URL=postgresql://nutribase:nutribase@localhost:5432/nutribase_db

# JWT
JWT_SECRET_KEY=troque-esta-chave-jwt-em-producao
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Upload de fotos de perfil
UPLOAD_FOLDER=uploads/profile_photos
MAX_CONTENT_LENGTH_MB=5

# "Envio" de e-mail (por enquanto simulado no console/log)
MAIL_SIMULATION=true
PASSWORD_RESET_CODE_EXPIRES_MINUTES=15
