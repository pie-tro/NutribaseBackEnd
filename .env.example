# Copie este arquivo para ".env" e ajuste os valores

# Flask
FLASK_APP=run.py
FLASK_ENV=development
# Gere cada chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# Banco de dados (valores batem com o docker-compose.yml)
DATABASE_URL=postgresql://nutribase:nutribase@localhost:5432/nutribase_db

# JWT
JWT_SECRET_KEY=troque-esta-chave-jwt-em-producao
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Upload de fotos de perfil
UPLOAD_FOLDER=uploads/profile_photos
MAX_CONTENT_LENGTH_MB=5

# E-mail de recuperação de senha. Com MAIL_SIMULATION=true o código só aparece no console.
# Para envio real use um provedor SMTP (ex.: Brevo: smtp-relay.brevo.com, porta 587).
MAIL_SIMULATION=true
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_CODE_EXPIRES_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Segurança
# Só rode com FLASK_DEBUG=1 na sua máquina; nunca com a API exposta na rede
FLASK_DEBUG=0
RATELIMIT_ENABLED=true
# Origens do CORS separadas por vírgula (o app mobile não depende disso)
CORS_ORIGINS=*
